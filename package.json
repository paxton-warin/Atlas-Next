{
  "name": "atlas-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/prepare-runtime.mjs && node scripts/source-archive.mjs && vite build --config vite.config.ts && vite build --config vite.runtime.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test && node scripts/summarize-browser.mjs",
    "admin:token": "node --env-file-if-exists=.env scripts/admin-token.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser",
    "format": "prettier --write web/src web/public runtime/host.ts runtime/index.html server tests scripts *.json *.ts *.yaml *.md docs",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "node:start": "node --env-file-if-exists=.env server/node.mjs"
  },
  "dependencies": {
    "@fastify/static": "9.0.0",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/wisp-js": "0.4.1",
    "argon2": "0.45.1",
    "fastify": "5.12.3",
    "gpt-tokenizer": "4.0.0",
    "ipaddr.js": "2.2.0",
    "lucide-react": "1.44.0",
    "mammoth": "1.12.2",
    "otpauth": "9.5.2",
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vite": "7.3.6",
    "ws": "8.21.1"
  },
  "license": "AGPL-3.0-only"
}
