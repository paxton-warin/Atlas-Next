/deployment-templates/
/compose.dispenser.yaml

# Consolidated local history, legacy worktrees, credentials and recovery copies.
# The dispenser source belongs to this repository; its former Git database and
# local verification files stay private and must never enter a commit.
/local-retained/
/dispenser/.git/
/dispenser/.codex/
/dispenser/....
