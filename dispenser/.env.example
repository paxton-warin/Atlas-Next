# Deployment secrets and infrastructure only. Operational policy lives in the admin console.
NODE_ENV=production
APP_BIND=127.0.0.1
APP_PORT=3000
# Immediate Caddy peers only; add its exact private IP when Caddy runs in Docker.
TRUSTED_PROXY_CIDRS=loopback
APP_URL=https://links.example.com
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://atlas_dispenser:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/atlas_dispenser
REDIS_URL=redis://redis:6379
SESSION_SECRET=CHANGE_ME_TO_A_32_BYTE_OR_LONGER_RANDOM_VALUE
DATA_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_BASE64_KEY
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_TOKEN=CHANGE_ME_TO_A_ONE_TIME_RANDOM_BOOTSTRAP_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://links.example.com/api/admin/google/callback

# Local-first cloud backup recovery: retain schema/read paths and pause producers.
ATLAS_BACKUP_V2_PUBLISH_DISABLED=false
# External bounded maintenance service uses the sole reserved maintenance slot.
ATLAS_BACKUP_MAINTENANCE_EXTERNAL=false
