HOST=127.0.0.1
PORT=4180
RUNTIME_PORT=4181
APP_ORIGIN=http://localhost:4180
RUNTIME_ORIGIN=http://127.0.0.1:4181
ADMIN_PATH=/_control/atlas-owner
DATA_DIR=./data
# Direct production: set HTTPS origins on two DISTINCT hostnames, HOST=0.0.0.0, NODE_ENV=production.
# CloudFront three-VPS: use compose.cloudfront.yaml and LOCAL_RELAY_MODE=frontend.
# Legacy mode uses paired-node frames. The combined v2 runtime keeps opaque
# frame URLs on the current frontend and uses the selected node for transport.
# LOCAL_RELAY_MODE=frontend
# Keep held until the complete combined package passes its acceptance gates.
ATLAS_BROWSER_RUNTIME=held
# Release activation: ATLAS_BROWSER_RUNTIME=opaque-v2 plus LOCAL_RELAY_MODE=frontend.
# OPAQUE_ASSETS_DIR=dist/opaque-runtime
# Run pnpm admin:token for one-time setup. Secrets never belong in browser bundles.

# Optional native AI chat. You can also configure this in Admin > AI provider.
# Saved administrator settings take precedence over these environment defaults.
AI_ENABLED=false
AI_PROTOCOL=responses
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Node pool: on a new installation, false disables local browsing by default.
# Existing installations: use Owner panel > Browsing nodes > Main server.
LOCAL_BROWSING=true
# CloudFront origins: see docs/NODES.md. Frontend aliases need no allowlist.

# Optional per-IP API limits. Owner > Request limits overrides these defaults.
IP_RATE_LIMIT_ENABLED=true
IP_RATE_LIMIT_WHITELIST=
IP_RATE_LIMIT_AI_CONCURRENT=2
# IP_RATE_LIMIT_RULES={"api":{"max":600,"windowSeconds":60}}
# Multi-provider Groq/Gemini/xAI setup: Owner > AI provider; see docs/AI.md.
# Use separate provider keys there. The legacy AI_* variables above remain supported.
