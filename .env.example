HOST=127.0.0.1
PORT=4180
RUNTIME_PORT=4181
APP_ORIGIN=http://localhost:4180
RUNTIME_ORIGIN=http://127.0.0.1:4181
ADMIN_PATH=/_control/atlas-owner
DATA_DIR=./data
# Production: set HTTPS origins on two DISTINCT hostnames, HOST=0.0.0.0, NODE_ENV=production.
# Run pnpm admin:token for one-time setup. Secrets never belong in browser bundles.

# Optional native AI chat. You can also configure this in Admin > AI provider.
# Saved administrator settings take precedence over these environment defaults.
AI_ENABLED=false
AI_PROTOCOL=responses
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Node pool: on a new installation, false disables local browsing by default.
# Existing installations: use Owner panel > Browsing nodes > Main server.
LOCAL_BROWSING=true
# CloudFront origins: see docs/NODES.md. Frontend aliases need no allowlist.
